# The format of the files. Spotless checks the Java, Gradle, JSON, TOML, Markdown and workflow files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.bat]
end_of_line = crlf
